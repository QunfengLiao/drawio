          <mxGeometry height="30" width="150" x="165" y="260" as="geometry" />
        </mxCell>
        <mxCell id="q-FDYTSIBexI1HtiMefr-24" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="会话记忆" vertex="1">
          <mxGeometry height="30" width="150" x="165" y="290" as="geometry" />
        </mxCell>
