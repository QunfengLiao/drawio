          <mxGeometry height="30" width="150" x="165" y="320" as="geometry" />
        </mxCell>
        <mxCell id="q-FDYTSIBexI1HtiMefr-26" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="任务生命周期管理" vertex="1">
          <mxGeometry height="30" width="150" x="165" y="350" as="geometry" />
        </mxCell>
        <mxCell id="q-FDYTSIBexI1HtiMefr-27" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="停止生成" vertex="1">
