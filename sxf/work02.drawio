  <diagram id="oEo6FE19AD67gDfZiRdF" name="智能问数">
    <mxGraphModel dx="2003" dy="781" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
